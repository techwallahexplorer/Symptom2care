# Vercel Ignore File
# Files and directories to exclude from deployment

# Documentation (optional - remove if you want to deploy docs)
*.md
!README.md

# Git files
.git
.gitignore

# IDE files
.vscode
.idea
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
.cache

# Test files (optional)
test.html
test-auth.html

# Node modules (if any)
node_modules/

# Environment files (if any)
.env
.env.local
.env.*.local
